# Copy to .env on each machine. Values fill ${VAR} in mcp.json. .env is not in git.
# A key that ends in _CLAUDE or _CODEX applies only to that tool (LORE_PROFILE_CODEX sets LORE_PROFILE for Codex).
# Each client needs its own Lore agent. Mac: Claude empty, Codex "codex". devbox: "claude-devbox", "codex-devbox".
LORE_PROFILE_CLAUDE=
LORE_PROFILE_CODEX=codex
